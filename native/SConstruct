#!/usr/bin/env python
# Written by Claude (claude-opus-5-5), 2026-11-03: builds the navcore GDExtension (godot-cpp + Recast/Detour + src/).
# Usage, from this folder:   python -m SCons            (debug build, used by the editor)
#                            python -m SCons target=template_release
# Output goes to ../bin/, next to navcore.gdextension.

# godot-cpp 10.0.0-stable, aimed at Godot 4.7's API. From version 10, godot-cpp is versioned apart from Godot and builds for any API
# from 4.3 up; api_version picks which one. An extension built for 4.7 won't load in an older Godot, which is why navcore.gdextension
# says compatibility_minimum = "4.7".
env = SConscript("thirdparty/godot-cpp/SConstruct", {"api_version": "4.7"})
env = env.Clone()  # don't leak our settings into the godot-cpp library build

recast = "thirdparty/recastnavigation/"
env.Append(CPPPATH=["src/", recast + "Recast/Include", recast + "Detour/Include"])
# 64-bit poly refs: room for many tiles and polys, and salt bits that make stale refs detectable.
# Must be defined for Detour's own sources AND ours, so it goes on the whole environment.
env.Append(CPPDEFINES=["DT_POLYREF64"])

# Recast and Detour sort with qsort, which isn't stable: ties come out in an order that depends on the platform's C runtime, so the
# nav mesh could differ between Windows and Linux. Their sources get src/stable_qsort.h forced in, which points qsort
# at a stable sort; the third-party files themselves are untouched. See src/stable_qsort.h and state store spec 13.11.
recast_env = env.Clone()
stable_qsort_header = File("src/stable_qsort.h").abspath
if recast_env.get("is_msvc", False):
    recast_env.Append(CCFLAGS=["/FI" + stable_qsort_header])
else:
    recast_env.Append(CCFLAGS=["-include", stable_qsort_header])
recast_objects = [recast_env.SharedObject(source) for source in Glob(recast + "Recast/Source/*.cpp") + Glob(recast + "Detour/Source/*.cpp")]
sources = Glob("src/*.cpp") + recast_objects

library = env.SharedLibrary(
    "../bin/navcore{}{}".format(env["suffix"], env["SHLIBSUFFIX"]),
    source=sources,
)
Default(library)
