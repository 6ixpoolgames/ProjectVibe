[gd_resource type="Resource" script_class="Effect" format=3]

[ext_resource type="Script" path="res://assets/scripts/effects/EffectPart.gd" id="1_part"]
[ext_resource type="Script" path="res://assets/scripts/effects/parts/StatChangePart.gd" id="2_stat"]
[ext_resource type="Script" path="res://assets/scripts/effects/parts/KnockbackPart.gd" id="3_knockback"]
[ext_resource type="Script" path="res://assets/scripts/effects/Effect.gd" id="4_effect"]

[sub_resource type="Resource" id="Resource_damage"]
script = ExtResource("2_stat")
amount = -15.0

[sub_resource type="Resource" id="Resource_push"]
script = ExtResource("3_knockback")
hop_speed = 1.0

[resource]
script = ExtResource("4_effect")
effect_name = &"bolt hit"
tags = Array[StringName]([&"effect.damage.physical"])
parts = Array[ExtResource("1_part")]([SubResource("Resource_damage"), SubResource("Resource_push")])
