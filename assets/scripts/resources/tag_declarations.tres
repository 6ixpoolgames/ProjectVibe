[gd_resource type="Resource" script_class="TagDeclarationsRes" load_steps=2 format=3]

[ext_resource type="Script" path="res://assets/scripts/resources/TagDeclarations_resource.gd" id="1_tagdecl"]

[resource]
script = ExtResource("1_tagdecl")
tags = Dictionary[StringName, String]({&"ability": "What an ability is: its category and groups. Lockouts, cancels and the AI's action lookup go by these.", &"ability.combat": "Fighting.", &"ability.combat.evade": "Getting out of an attack's way.", &"ability.combat.knockback": "Being knocked back by a hit: the pawn's stagger.", &"ability.combat.melee": "A close-range attack: a swing or a thrust.", &"ability.combat.parry": "Turning an attack aside.", &"ability.combat.ranged": "An attack that fires a projectile or a hitscan shot.", &"ability.combo": "Steps of a combo: each step boosts the next, so the next press picks it.", &"ability.combo.finisher": "A combo's finishing swing.", &"ability.combo.second": "A combo's second swing.", &"ability.death": "Dying: the ability that plays out a pawn's death.", &"ability.movement": "Moving the pawn.", &"ability.movement.advanced": "A group: dash, and later a grappling hook.", &"ability.movement.basic": "A group: walk, sprint and jump.", &"ability.movement.dash": "A quick burst of movement.", &"ability.movement.jump": "Jumping.", &"ability.movement.sprint": "Sprinting.", &"ability.movement.walk": "Walking.", &"ability.utility": "Doing something other than moving or fighting.", &"ability.utility.heal": "Healing.", &"ability.utility.interact": "Using something in the world: a door, a lever, an item.", &"ai": "The AI's own tags: its states and stances.", &"ai.state": "The AI's state: what situation it thinks it is in. A pawn owns one while its AI runs.", &"ai.state.alert": "Something caught its attention, but it isn't sure of a target yet.", &"ai.state.combat": "It has a target it is sure of, and fights.", &"ai.state.idle": "Nothing has its attention.", &"ai.stance": "How a behaviour fights: the AI's fighting styles, which score modifiers can favour.", &"ai.stance.melee": "Fighting up close: closing in to swing.", &"ai.stance.ranged": "Fighting from a distance: keeping away and shooting.", &"effect": "What an effect is. Resistances, immunities and removing effects by kind go by these.", &"effect.buff": "A helpful effect.", &"effect.buff.combo": "A combo step's boost to the next swing.", &"effect.damage": "Damage of any kind.", &"effect.damage.elemental": "Elemental damage of any kind.", &"effect.damage.elemental.fire": "Fire damage.", &"effect.damage.elemental.frost": "Frost damage.", &"effect.damage.physical": "Physical damage: blades, blunt hits, bolts.", &"effect.damage.poison": "Poison damage.", &"effect.debuff": "A harmful effect other than damage.", &"effect.debuff.slow": "Slowing the pawn down.", &"effect.heal": "Restoring health.", &"nav": "Navigation: what a place, link or marker is, so pawns and the AI can find and use it.", &"nav.area": "A kind of ground (a nav modifier volume); each kind of agent has its own cost for it.", &"nav.area.forbidden": "Ground pawns don't enter.", &"nav.area.hazard": "Dangerous ground.", &"nav.area.road": "A road.", &"nav.area.water": "Water.", &"nav.link": "A connection between two places, crossed with an action.", &"nav.link.climb": "Crossed by climbing: a ladder or a wall.", &"nav.link.door": "A door.", &"nav.link.jump": "Crossed by jumping: a gap or a ledge.", &"nav.link.teleport": "A teleporter.", &"nav.obstacle": "Something in the way that moves or can be moved (a dynamic obstacle).", &"nav.obstacle.crate": "A crate.", &"nav.obstacle.vehicle": "A vehicle.", &"nav.point": "A tactical point: a spot the AI goes to for a reason.", &"nav.point.ambush": "A spot to wait in ambush.", &"nav.point.cover": "Cover from attacks.", &"nav.point.patrol": "A stop on a patrol route.", &"nav.point.wander": "A spot to wander to.", &"nav.use": "A smart object: something pawns use in place, a few at a time.", &"nav.use.pickup": "Something to pick up.", &"nav.use.seat": "A seat.", &"nav.use.work": "A place to work: a forge, a desk, a field.", &"status": "A condition a pawn is in right now.", &"status.dead": "The pawn is dead.", &"status.has_ammo": "An ability with limited uses has some left.", &"status.has_ammo.ranged": "A ranged attack has shots left.", &"event": "What happened to an entity: gameplay events, sent with Pawn.send_event and a payload (GameplayEventData).", &"event.damage": "Damage happened.", &"event.damage.taken": "The pawn lost Health to an effect; the payload has the source and the amount.", &"event.health": "The pawn's Health crossed a threshold.", &"event.health.depleted": "Health reached 0: Death starts.", &"event.health.low": "Health fell to a quarter of its max or below."})
redirects = Dictionary[StringName, StringName]({&"movement": &"ability.movement", &"movement.walk": &"ability.movement.walk", &"movement.sprint": &"ability.movement.sprint", &"movement.jump": &"ability.movement.jump", &"movement.dash": &"ability.movement.dash", &"movement.basic": &"ability.movement.basic", &"movement.advanced": &"ability.movement.advanced", &"combat": &"ability.combat", &"combat.melee": &"ability.combat.melee", &"combat.ranged": &"ability.combat.ranged", &"combat.evade": &"ability.combat.evade", &"combat.knockback": &"ability.combat.knockback", &"combat.parry": &"ability.combat.parry", &"utility": &"ability.utility", &"utility.heal": &"ability.utility.heal", &"utility.interact": &"ability.utility.interact", &"combo": &"ability.combo", &"combo.second": &"ability.combo.second", &"combo.finisher": &"ability.combo.finisher", &"damage": &"effect.damage", &"damage.physical": &"effect.damage.physical", &"damage.elemental": &"effect.damage.elemental", &"damage.elemental.fire": &"effect.damage.elemental.fire", &"damage.elemental.frost": &"effect.damage.elemental.frost", &"damage.poison": &"effect.damage.poison", &"heal": &"effect.heal", &"buff": &"effect.buff", &"buff.combo": &"effect.buff.combo", &"debuff": &"effect.debuff", &"debuff.slow": &"effect.debuff.slow", &"link": &"nav.link", &"link.jump": &"nav.link.jump", &"link.climb": &"nav.link.climb", &"link.door": &"nav.link.door", &"link.teleport": &"nav.link.teleport", &"area": &"nav.area", &"area.road": &"nav.area.road", &"area.hazard": &"nav.area.hazard", &"area.water": &"nav.area.water", &"area.forbidden": &"nav.area.forbidden", &"obstacle": &"nav.obstacle", &"obstacle.crate": &"nav.obstacle.crate", &"obstacle.vehicle": &"nav.obstacle.vehicle", &"point": &"nav.point", &"point.cover": &"nav.point.cover", &"point.patrol": &"nav.point.patrol", &"point.ambush": &"nav.point.ambush", &"point.wander": &"nav.point.wander", &"use": &"nav.use", &"use.seat": &"nav.use.seat", &"use.work": &"nav.use.work", &"use.pickup": &"nav.use.pickup"})
